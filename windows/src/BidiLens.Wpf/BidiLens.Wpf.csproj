<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>BidiLens.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Authors>Shayan / BidiLens contributors</Authors>
    <Description>Non-destructive BidiLens integration for WPF TextBlock and TextBox.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CodeinScrubs/BidiLens</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BidiLens.Core\BidiLens.Core.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
